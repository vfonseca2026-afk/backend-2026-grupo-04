  "nombre_usuario": "qa_activo_{{run}}",
  "email": "qa.activo.{{run}}@example.com"
}

### T07. Consultar usuario — 200
GET {{baseUrl}}/usuarios/{{crearUsuarioQA.response.body.$.id}}

### T07. Actualizar conservando correo y nombre — 200
PUT {{baseUrl}}/usuarios/{{crearUsuarioQA.response.body.$.id}}
Content-Type: application/json

{
  "nombre_usuario": "qa_activo_{{run}}",
  "email": "qa.activo.{{run}}@example.com",
  "activo": true
}

### T07. Listado paginado — 200
GET {{baseUrl}}/usuarios?pagina=1&limite=1

